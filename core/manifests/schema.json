{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HelioUSACH/clima-espacial/core/manifests/schema.json",
  "title": "Product manifest",
  "description": "docs/ARCHITECTURE.md §4.1",
  "type": "object",
  "required": ["id", "version", "kind", "title", "maturity", "cadence", "stale_after", "producer", "source"],
  "additionalProperties": false,
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": ["es", "en"],
      "additionalProperties": false,
      "properties": {
        "es": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "duration": {"type": "string", "pattern": "^[0-9]+(s|m|h|d)$"}
  },
  "allOf": [
    {
      "description": "D-071: a forecast declares its forecast block and a model card; nothing else may carry a forecast block.",
      "if": {"properties": {"kind": {"const": "forecast"}}, "required": ["kind"]},
      "then": {"required": ["forecast", "model_card"]},
      "else": {"not": {"required": ["forecast"]}}
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "namespace.domain.name, e.g. usach.flare.nrt"
    },
    "version": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["timeseries", "event", "image", "bulletin", "index", "status", "forecast"]},
    "title": {
      "type": "object",
      "required": ["es", "en"],
      "additionalProperties": false,
      "properties": {
        "es": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "maturity": {"enum": ["experimental", "beta", "operational"]},
    "cadence": {"type": "string", "pattern": "^[0-9]+(s|m|h|d)$"},
    "stale_after": {"type": "string", "pattern": "^[0-9]+(s|m|h|d)$"},
    "producer": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["collector", "service"]},
        "unit": {"type": "string"},
        "repo": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": ["provider"],
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "license": {"type": "string"},
        "links": {
          "type": "array",
          "description": "D-078: the provider's own page(s) for this product, primary first. `name` is a short proper name, not translated.",
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "url": {"type": "string", "pattern": "^https://"}
            }
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "units": {"type": "string"},
          "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "enum": {"type": "array"},
          "shape": {"type": "array", "items": {"type": "integer"}}
        }
      }
    },
    "revise": {
      "type": "object",
      "description": "D-080: a revisable series. Rows with time_tag >= (latest stored - window) are updated when the provider's value changes; without it, D-049's skip-if-not-newer rule applies.",
      "required": ["window"],
      "additionalProperties": false,
      "properties": {
        "window": {"$ref": "#/$defs/duration"},
        "version_field": {"type": "string", "description": "A parameter compared as an integer: a lower incoming version never overwrites a higher stored one."},
        "key": {"type": "array", "items": {"type": "string"}, "description": "Reserved: the row key besides time_tag for products with several rows per time_tag (energy channels). Not supported yet."}
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hapi": {"type": "boolean"},
        "feed": {"type": "boolean"},
        "push": {"type": "array", "items": {"type": "string"}}
      }
    },
    "model_card": {"type": "string"},
    "forecast": {
      "type": "object",
      "description": "D-071: kind forecast only. The model id is the product id; the model version is passed per issue to swxkit.publish_forecast; `cadence` is the issue cadence.",
      "required": ["target", "horizons", "uncertainty", "sites"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "object",
          "description": "An existing observed product (kind timeseries or index) and one of its parameters; checked across manifests by validate_manifests.",
          "required": ["product", "field"],
          "additionalProperties": false,
          "properties": {
            "product": {"type": "string", "minLength": 1},
            "field": {"type": "string", "minLength": 1}
          }
        },
        "horizons": {"type": "array", "items": {"$ref": "#/$defs/duration"}, "minItems": 1, "uniqueItems": true},
        "uncertainty": {
          "type": "object",
          "description": "none, or bounds: a central interval at nominal coverage `level`. quantiles is reserved: the schema accepts it, publish_forecast rejects it in 0.4.",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["none", "bounds", "quantiles"]},
            "level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
          },
          "if": {"properties": {"type": {"const": "bounds"}}},
          "then": {"required": ["level"]}
        },
        "sites": {"type": "boolean", "description": "true if rows carry a site code (stations, grid cells); false for a global index."},
        "baseline": {"enum": ["persistence"], "description": "D-079: this product is the persistence reference itself; verify_forecasts warns when its issued values stop matching the reconstructed reference."}
      }
    },
    "description": {
      "$ref": "#/$defs/bilingual",
      "description": "18-HANDOFF-v0.2.0.md §2: the product page's 'Qué muestra' text."
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "description": "18-HANDOFF-v0.2.0.md §2: the product page's 'Ficha del producto' <dl>.",
      "properties": {
        "source": {"$ref": "#/$defs/bilingual"},
        "spacecraft": {"$ref": "#/$defs/bilingual"},
        "cadence": {"$ref": "#/$defs/bilingual"},
        "coordinates": {"$ref": "#/$defs/bilingual"},
        "license": {"$ref": "#/$defs/bilingual"},
        "citation": {"$ref": "#/$defs/bilingual"},
        "used_by": {"$ref": "#/$defs/bilingual"}
      }
    }
  }
}
