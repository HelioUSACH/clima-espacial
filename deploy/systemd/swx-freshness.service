# One oneshot run of `manage.py check_freshness` (D-119): e-mails
# SWX_ALERT_EMAILS when a product turns stale or recovers. Triggered by
# swx-freshness.timer. Without SWX_ALERT_EMAILS or SMTP it sends nothing.
[Unit]
Description=Clima Espacial USACH: stale-product e-mail
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=swx
Group=swx
WorkingDirectory=/opt/swx
EnvironmentFile=/etc/swx/swx.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/swx/venv/bin/python manage.py check_freshness
TimeoutStartSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
