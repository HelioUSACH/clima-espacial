msgstr "Context strip"

msgid "Lo que ofrece USACH"
msgstr "What USACH offers"

msgid "beta"
msgstr "beta"

msgid "Detección de fulguraciones (NRT)"
msgstr "Flare detection (NRT)"

msgid "Modelo propio de HelioUSACH, probabilidad y estado en casi tiempo real."
msgstr "HelioUSACH's own model, near-real-time probability and state."

msgid "En preparación — este producto se activa sin bloquear el resto del portal (ver docs/models/INTEGRATION.md)."
msgstr "In preparation — this product turns on without blocking the rest of the portal (see docs/models/INTEGRATION.md)."

