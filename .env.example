# Copy to .env (never committed) and adjust. On the server these live in
# /etc/swx/swx.env. Plain KEY=value lines: no quotes, no spaces.

# climaespacial.settings.dev locally; climaespacial.settings.prod for the server
DJANGO_SETTINGS_MODULE=climaespacial.settings.dev

# Required outside dev. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# postgresql://USER:PASSWORD@HOST:PORT/NAME
# Server (local socket, peer authentication): postgresql:///swx?host=/var/run/postgresql
DATABASE_URL=postgresql://swx:swx-dev@localhost:5432/swx

# Comma-separated
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, with scheme, e.g. https://helio.fisica.usach.cl
CSRF_TRUSTED_ORIGINS=

# dev | staging | produccion
SWX_AMBIENTE=dev
# 1 once served over HTTPS (secure cookies, HSTS, redirect); 0 otherwise
SWX_HTTPS=0

# Sub-path deployment (D-005): empty in dev, "/clima-espacial" on the server.
# STATIC_URL is derived from this: "<prefix>/static/".
SWX_SCRIPT_NAME=

# Where collectstatic writes. Server: /var/www/clima-espacial/static
STATIC_ROOT=

# Where producers (collectors) write rolling files (raw downloads, images).
# Server: /srv/swx/data
SWX_DATA_DIR=./data

# Shown on the data/API registration form's privacy notice (D-051/P6).
# Must be set to a real, monitored address before accepting real registrations.
SWX_CONTACT_EMAIL=


# --- Email (optional, D-086) ---------------------------------------------------
# Used only to send a new API key to the person who registered. Leave
# SWX_EMAIL_HOST empty and no email is ever attempted: the key is shown once
# on screen and the page doesn't mention email. Values live only in
# /etc/swx/swx.env on the server, never in git. For a Google Workspace
# account: host smtp.gmail.com, port 587, TLS 1, and an app password.
SWX_EMAIL_HOST=
SWX_EMAIL_PORT=587
SWX_EMAIL_USE_TLS=1
SWX_EMAIL_HOST_USER=
SWX_EMAIL_HOST_PASSWORD=
# The From: address (the same account, or an alias it is allowed to send as).
SWX_EMAIL_FROM=

# --- API limits (optional; these are the defaults, D-083/D-086/D-087) --------
# Per key (service keys get SWX_API_SERVICE_MULTIPLIER times as much):
# SWX_API_RATE_PER_MINUTE=60
# SWX_API_DAILY_REQUESTS=5000
# SWX_API_DAILY_ROWS=2000000
# SWX_API_SERVICE_MULTIPLIER=10
# Without a key: at most this many hours, ending within this many days,
# this many requests per hour per client IP:
# SWX_API_KEYLESS_MAX_HOURS=24
# SWX_API_KEYLESS_RECENT_DAYS=7
# SWX_API_KEYLESS_PER_HOUR=30
# Per request: days for a series at <= 5 min cadence, days otherwise, rows:
# SWX_EXPORT_MAX_DAYS_FAST=31
# SWX_EXPORT_MAX_DAYS_SLOW=366
# SWX_EXPORT_MAX_ROWS=200000
# SWX_FORECAST_MAX_DAYS=31
# New registrations per client IP per day:
# SWX_REGISTRATIONS_PER_IP_DAY=5
